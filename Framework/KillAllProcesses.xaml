                <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim sb As New System.Text.StringBuilder()&#xA;Dim errorCount As Integer = 0&#xA;Dim deletedCount As Integer = 0&#xA;&#xA;Try&#xA;    Dim localAppData As String = Environment.GetEnvironmentVariable(&quot;LOCALAPPDATA&quot;)&#xA;    Dim basePath As String = System.IO.Path.Combine(localAppData, &quot;Google&quot;, &quot;Chrome&quot;, &quot;User Data&quot;, in_ProfileName)&#xA;&#xA;    sb.AppendLine(&quot;Profile path: &quot; &amp; basePath)&#xA;&#xA;    If Not System.IO.Directory.Exists(basePath) Then&#xA;        Throw New System.IO.DirectoryNotFoundException(&quot;Chrome profile folder not found: &quot; &amp; basePath)&#xA;    End If&#xA;&#xA;    ' ---- Cache folders: delete contents, keep the folder ----&#xA;    Dim cacheFolders As String() = New String() {&quot;Cache&quot;, &quot;Code Cache&quot;, &quot;GPUCache&quot;, &quot;Service Worker\CacheStorage&quot;}&#xA;&#xA;    For Each folder As String In cacheFolders&#xA;        Dim fullPath As String = System.IO.Path.Combine(basePath, folder)&#xA;        Try&#xA;            If System.IO.Directory.Exists(fullPath) Then&#xA;                For Each f As String In System.IO.Directory.GetFiles(fullPath)&#xA;                    Try&#xA;                        System.IO.File.SetAttributes(f, System.IO.FileAttributes.Normal)&#xA;                        System.IO.File.Delete(f)&#xA;                        deletedCount += 1&#xA;                    Catch exFile As Exception&#xA;                        errorCount += 1&#xA;                        sb.AppendLine(&quot;[ERROR] File &quot; &amp; f &amp; &quot; : &quot; &amp; exFile.Message)&#xA;                    End Try&#xA;                Next&#xA;                For Each d As String In System.IO.Directory.GetDirectories(fullPath)&#xA;                    Try&#xA;                        System.IO.Directory.Delete(d, True)&#xA;                        deletedCount += 1&#xA;                    Catch exDir As Exception&#xA;                        errorCount += 1&#xA;                        sb.AppendLine(&quot;[ERROR] Folder &quot; &amp; d &amp; &quot; : &quot; &amp; exDir.Message)&#xA;                    End Try&#xA;                Next&#xA;                sb.AppendLine(&quot;[OK] Cleared cache folder: &quot; &amp; folder)&#xA;            Else&#xA;                sb.AppendLine(&quot;[SKIP] Not found: &quot; &amp; folder)&#xA;            End If&#xA;        Catch exFolder As Exception&#xA;            errorCount += 1&#xA;            sb.AppendLine(&quot;[ERROR] Cache folder &quot; &amp; folder &amp; &quot; : &quot; &amp; exFolder.Message)&#xA;        End Try&#xA;    Next&#xA;&#xA;    ' ---- History and related files ----&#xA;    Dim historyFiles As String() = New String() {&quot;History&quot;, &quot;History-journal&quot;, &quot;Visited Links&quot;, &quot;Top Sites&quot;, &quot;Top Sites-journal&quot;, &quot;Favicons&quot;, &quot;Favicons-journal&quot;}&#xA;&#xA;    For Each hFile As String In historyFiles&#xA;        Dim fp As String = System.IO.Path.Combine(basePath, hFile)&#xA;        Try&#xA;            If System.IO.File.Exists(fp) Then&#xA;                System.IO.File.SetAttributes(fp, System.IO.FileAttributes.Normal)&#xA;                System.IO.File.Delete(fp)&#xA;                deletedCount += 1&#xA;                sb.AppendLine(&quot;[OK] Deleted: &quot; &amp; hFile)&#xA;            Else&#xA;                sb.AppendLine(&quot;[SKIP] Not found: &quot; &amp; hFile)&#xA;            End If&#xA;        Catch exHist As Exception&#xA;            errorCount += 1&#xA;            sb.AppendLine(&quot;[ERROR] &quot; &amp; hFile &amp; &quot; : &quot; &amp; exHist.Message)&#xA;        End Try&#xA;    Next&#xA;&#xA;Catch ex As Exception&#xA;    errorCount += 1&#xA;    sb.AppendLine(&quot;[FATAL] &quot; &amp; ex.GetType().Name &amp; &quot; : &quot; &amp; ex.Message)&#xA;End Try&#xA;&#xA;sb.AppendLine(&quot;Summary -&gt; Deleted items: &quot; &amp; deletedCount &amp; &quot; | Errors: &quot; &amp; errorCount)&#xA;out_Log = sb.ToString()&#xA;out_Success = (errorCount = 0)" DisplayName="Invoke Code-Clear Chrome History And Cache" sap:VirtualizedContainerService.HintSize="416,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
