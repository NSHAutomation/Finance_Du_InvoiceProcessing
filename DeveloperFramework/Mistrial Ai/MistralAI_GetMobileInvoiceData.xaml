uot; / &quot;, g.Select(Function(r As System.Data.DataRow) r(&quot;Community Name&quot;).ToString.Trim).Distinct())&#xA;        unmatched.Add(g.Key.Substring(7))&#xA;    Else&#xA;        names = in_distMobileCommunitys(g.Key).Item1&#xA;    End If&#xA;&#xA;    Dim total As Decimal = g.Sum(Function(r As System.Data.DataRow) Decimal.Parse(r(&quot;Sub Total&quot;).ToString.Trim, System.Globalization.CultureInfo.InvariantCulture))&#xA;&#xA;    dt.Rows.Add(first(&quot;Invoice Date&quot;).ToString,first(&quot;Due Date&quot;).ToString, first(&quot;Your Bill Cycle From&quot;).ToString.Trim, first(&quot;Your Bill Cycle To&quot;).ToString.Trim, _&#xA;                first(&quot;This Month Charges&quot;).ToString, first(&quot;VAT&quot;).ToString, first(&quot;Your Bill Number&quot;).ToString, _&#xA;                first(&quot;Your Account Number&quot;).ToString, names, code, ids, total.ToString(&quot;0.00&quot;, System.Globalization.CultureInfo.InvariantCulture))&#xA;Next&#xA;&#xA;dt_Out = dt&#xA;str_Unmatched = String.Join(&quot;,&quot;, unmatched)" DisplayName="Invoke Code- Add Sub Total of same cumminities and generate consolidated excel" sap:VirtualizedContainerService.HintSize="416,57" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
